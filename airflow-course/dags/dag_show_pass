from airflow.models.dag import DAG
from datetime import datetime

from airflow.operators.python import PythonOperator
from airflow.operators.empty import EmptyOperator
from airflow.hooks.base impoer BaseHook

def test_func(**context):
    test_con = BaseHook.get_connection("Postgres_first")
    print(test_con.host)
    res = test_con.password
    for i in res
       print(i)

       
with DAG(
    dag_id="dag_show_pass",
    schedule="@once",
    start_date=datetime(year=2026, month=4, day=29),
) as dag:

    start_dag = EmptyOperator(
        task_id="start_dag",
    )

    end_dag = EmptyOperator(
        task_id="end_dag",
    )

    test = PythonOperator(
        task_id="test",
        python_callable=test_func,
   
    )

    start_dag >> test >> end_dag